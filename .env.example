# Copy to .env (npm run setup does this and fills in random secrets).

# --- API ---
API_PORT=4000
# Leave empty to use the built-in PGlite database in ./data/pg (development only).
# Production: postgres://user:password@host:5432/vwelfare
DATABASE_URL=
DATA_DIR=./data
# 32 random bytes, base64. Encrypts message text, mobile numbers, MFA secrets and files.
# Production: replace with a key from the cloud key-management service.
FIELD_ENCRYPTION_KEY=
# Public address of the web app, used in invitation links.
APP_BASE_URL=http://localhost:5173
# The center's time zone, used for chat record names and working hours (IANA name). Empty = Asia/Amman.
CENTER_TIMEZONE=
# Set to true behind HTTPS in production.
COOKIE_SECURE=false
# Proxies allowed to set X-Forwarded-For: addresses or CIDR ranges, comma-separated.
# Leave empty for a proxy on the same machine (or on Vercel, whose edge sets the header itself).
# Set it to your load balancer's address range in production.
TRUST_PROXY=

# The national emergency number (digits, spaces, +). Patients see it whenever the admin hasn't saved one,
# so the crisis panel is never empty. Empty = 911 (Jordan).
EMERGENCY_NUMBER=

# --- EMR connection ---
EMR_BASE_URL=http://localhost:4100
EMR_CLIENT_ID=vwelfare-connect
EMR_CLIENT_SECRET=dev-secret
# Hosts the EMR address may point to, comma-separated (host or host:port). The super admin can change
# EMR_BASE_URL in the secrets list, but only to one of these. Empty = only the host of EMR_BASE_URL above.
# Production also requires https.
EMR_ALLOWED_HOSTS=

# --- Vercel only ---
# Bearer token Vercel Cron sends to GET /api/internal/worker. Required on Vercel.
CRON_SECRET=
# MOCK_EMR_URL is injected by the binding in vercel.json; don't set it.

# --- Development seed (npm run seed) ---
SEED_ADMIN_EMAIL=admin@vwelfare.example

# --- Mock EMR ---
MOCK_EMR_PORT=4100
