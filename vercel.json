{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/server.ts",
      "bindings": [
        {
          "type": "service",
          "service": "mock-emr",
          "format": "url",
          "env": "MOCK_EMR_URL"
        }
      ]
    },
    "mock-emr": {
      "root": "apps/mock-emr",
      "framework": "fastify",
      "entrypoint": "src/server.ts"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(staff|admin|provider|patient|invite/.*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/internal/worker",
      "schedule": "* * * * *"
    }
  ]
}
