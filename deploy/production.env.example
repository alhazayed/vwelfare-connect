# Settings for the API container (deploy/compose.yaml). Copy to deploy/production.env and fill in.
# Keep the real file in the center's secret store; never commit it.

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts messages, mobile numbers, MFA secrets,
# saved secrets and files. Losing it makes all of them unreadable; changing it needs a key rotation.
FIELD_ENCRYPTION_KEY=
# The password must match deploy/db_password.txt.
DATABASE_URL=postgres://vwelfare:CHANGE_ME@db:5432/vwelfare
# The address people open, used in invitation links.
APP_BASE_URL=https://connect.vwelfare.example
CENTER_TIMEZONE=Asia/Amman
EMERGENCY_NUMBER=911
# Klinikat's API (https). EMR_ALLOWED_HOSTS lists every host the super admin may point the EMR at.
EMR_BASE_URL=
EMR_CLIENT_ID=
EMR_CLIENT_SECRET=
EMR_ALLOWED_HOSTS=
